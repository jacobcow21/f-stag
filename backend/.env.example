# Copy to .env and fill in values — never commit .env

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# IMPORTANT: If your password contains special characters (@, #, /, etc.), percent-encode them.
# Example: @ → %40, # → %23
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/soccer_analytics?retryWrites=true&w=majority

# Database name (also embedded in URI above, used independently for clarity)
MONGODB_DB_NAME=soccer_analytics

# API config
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:4200
